            },
            {
              "id": "A03",
              "text": "Maximiza o rendimento do produto."
            },
            {
              "id": "A04",
              "text": "Minimiza a energia livre de Gibbs."
            },
            {
              "id": "A05",
              "text": "Aumenta a constante de equilíbrio."
            }
          ],
          "correct": "A02",
          "subject": "Química > Equilíbrio Químico",
          "difficulty": "facil",
