              "id": "A02",
              "text": "~0,5 g CH₃OH/g NO₃⁻-N"
            },
            {
              "id": "A03",
              "text": "~10 g CH₃OH/g NO₃⁻-N"
            },
            {
              "id": "A04",
              "text": "~20 g CH₃OH/g NO₃⁻-N"
            },
            {
              "id": "A05",
              "text": "~0,1 g CH₃OH/g NO₃⁻-N"
            }
          ],
          "correct": "A01",
          "subject": "Química > Tratamento de Esgoto",
