        {
          "id": 20,
          "originalNumber": "20",
          "label": "Questão 20",
          "text": "O controle de odor em ETE (H₂S, mercaptanos, amônia, VOCs) usa: lavadores químicos (NaOH + NaOCl/ H₂O₂), biofiltros, carvão ativado, oxidação térmica. Para H₂S em fase gasosa, a oxidação alcalina:",
          "alternatives": [
            {
              "id": "A01",
              "text": "H₂S + 4NaOCl → Na₂SO₄ + 4NaCl + H₂O (pH > 10)."
            },
            {
              "id": "A02",
              "text": "H₂S + 2NaOH → Na₂S + 2H₂O (forma sulfeto solúvel, não remove odor)."
            },
            {
              "id": "A03",
              "text": "H₂S + O₂ → SO₂ + H₂O (forma SO₂, tóxico)."
